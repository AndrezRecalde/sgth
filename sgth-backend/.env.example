APP_NAME="SGTH GAD Esmeraldas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Origen del SPA. Lo usan CORS y los enlaces de los correos: sin esta variable
# apuntan a la API en vez de a la pantalla.
FRONTEND_URL=http://localhost:3000
# IP o rangos CIDR (separados por comas) de los proxies delante de Laravel:
# el nginx del despliegue y, si reenvía /api, el contenedor de Next. Sin esto,
# detrás de un proxy todas las peticiones llegan con la IP del proxy. Nunca *.
# Ej.: TRUSTED_PROXIES=172.28.0.0/16
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fuera de producción, TODO el correo se desvía a esta dirección, diga lo que
# diga el código. La base de desarrollo tiene direcciones reales de servidores
# y el sistema manda documentos con cédula. Vacío = no se desvía nada.
MAIL_BUZON_DE_PRUEBAS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=

# Biométrico (Sirha7) — marcaciones por cédula y marcación online.
# El puerto es el de la instancia ATIEMPO, que es dinámico: no es el 1433.
# El usuario es sgth_app, nunca sa: solo puede ejecutar los procedimientos
# de database/sqlsrv/ (ver usuario_sgth_app.sql).
DB_SQLSRV_HOST=
DB_SQLSRV_PORT=
DB_SQLSRV_DATABASE=Sirha7
DB_SQLSRV_USERNAME=sgth_app
DB_SQLSRV_PASSWORD=
BIOMETRICO_SENSOR_ONLINE=2
