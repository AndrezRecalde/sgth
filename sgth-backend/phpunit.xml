<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" />
        <env name="DB_CONNECTION" value="pgsql" />
        <env name="DB_DATABASE" value="sgth_testing" />
        <!-- CACHE_STORE, no CACHE_DRIVER: ese es el nombre de Laravel 10, y
             desde la 11 `config/cache.php` lee `env('CACHE_STORE')`. La línea
             no hacía nada, así que las pruebas acababan usando el almacén del
             `.env` de cada máquina; con el `database` que entrega `.env.example`
             fallaban las diez que usan caché etiquetada, porque ese almacén no
             soporta etiquetas. -->
        <env name="CACHE_STORE" value="array" />
        <env name="QUEUE_CONNECTION" value="sync" />
        <env name="SESSION_DRIVER" value="array" />
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost" />
    </php>
</phpunit>