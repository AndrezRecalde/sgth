# ── Sistema operativo ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs y editores ────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
.antigravity/cache/

# ── Laravel (sgth-backend) ─────────────────────────────────────────
sgth-backend/.env
sgth-backend/.env.backup
sgth-backend/.env.testing
sgth-backend/vendor/
sgth-backend/node_modules/
sgth-backend/storage/logs/*.log
sgth-backend/storage/app/public/
# Su contenido, no los directorios: ignorarlos enteros impedía commitear los
# `.gitignore` que Laravel pone dentro, y como git no guarda directorios
# vacíos, un clon nuevo se quedaba sin ellos. `composer install` fallaba en
# `package:discover` con «Please provide a valid cache path», que es el
# compilador de vistas buscando `storage/framework/views`. Las reglas de cada
# directorio ya ignoran lo que hay dentro.
sgth-backend/storage/framework/cache/*
!sgth-backend/storage/framework/cache/.gitignore
!sgth-backend/storage/framework/cache/data/
sgth-backend/storage/framework/cache/data/*
!sgth-backend/storage/framework/cache/data/.gitignore
sgth-backend/storage/framework/sessions/*
!sgth-backend/storage/framework/sessions/.gitignore
sgth-backend/storage/framework/views/*
!sgth-backend/storage/framework/views/.gitignore
sgth-backend/bootstrap/cache/*.php
sgth-backend/.phpunit.result.cache
sgth-backend/coverage/

# ── Next.js (sgth-frontend) ────────────────────────────────────────
sgth-frontend/.env.local
sgth-frontend/.env.development.local
sgth-frontend/.env.test.local
sgth-frontend/.env.production.local
sgth-frontend/node_modules/
sgth-frontend/.next/
sgth-frontend/out/
sgth-frontend/coverage/

# ── Docker ─────────────────────────────────────────────────────────
docker/postgres/data/
docker/redis/data/

# ── Archivos sensibles ─────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12